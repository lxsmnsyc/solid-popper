{
  "name": "solid-popper",
  "version": "0.3.0",
  "private": false,
  "description": "SolidJS bindings for Popper.js",
  "keywords": [
    "popover",
    "popper",
    "popper.js",
    "solid",
    "solid-js",
    "tooltip"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-popper/tree/main/packages/solid-popper",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-popper/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-popper.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@popperjs/core": "2.11.8",
    "@solidjs/vite-plugin": "3.0.0",
    "@solidjs/web": "2.0.0",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.1",
    "solid-js": "2.0.0",
    "tsdown": "^0.23.7",
    "tslib": "^2.9.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@popperjs/core": "^2.11.8",
    "solid-js": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
