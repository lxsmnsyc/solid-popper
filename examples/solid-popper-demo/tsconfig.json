{
  "include": ["src", "vite.config.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  }
}
